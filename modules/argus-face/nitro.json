{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["argus", "face"],
  "ios": {
    "iosModuleName": "ArgusFace"
  },
  "android": {
    "androidNamespace": ["face"],
    "androidCxxLibName": "ArgusFace"
  },
  "autolinking": {
    "ArgusFace": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridArgusFace"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridArgusFace"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}