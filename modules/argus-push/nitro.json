{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["argus", "push"],
  "ios": {
    "iosModuleName": "ArgusPush"
  },
  "android": {
    "androidNamespace": ["push"],
    "androidCxxLibName": "ArgusPush"
  },
  "autolinking": {
    "ArgusPush": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridArgusPush"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridArgusPush"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
