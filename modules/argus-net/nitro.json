{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["argus", "net"],
  "ios": {
    "iosModuleName": "ArgusNet"
  },
  "android": {
    "androidNamespace": ["net"],
    "androidCxxLibName": "ArgusNet"
  },
  "autolinking": {
    "ArgusNet": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridArgusNet"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridArgusNet"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
