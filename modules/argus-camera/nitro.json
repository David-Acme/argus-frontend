{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["argus", "camera"],
  "ios": {
    "iosModuleName": "ArgusCamera"
  },
  "android": {
    "androidNamespace": ["camera"],
    "androidCxxLibName": "ArgusCamera"
  },
  "autolinking": {
    "ArgusCameraView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridArgusCameraView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridArgusCameraView"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
