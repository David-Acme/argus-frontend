{
  "name": "argus-frontend",
  "author": "David Acme",
  "license": "SEE LICENSE IN LICENSE",
  "main": "index.ts",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson",
          "argus-face",
          "argus-net",
          "argus-mic",
          "argus-camera"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "lint": "expo lint",
    "test": "tsc -p tests && bun test tests/unit tests/contracts",
    "test:bench": "bun test tests/bench",
    "check:comments": "bun scripts/check-comments.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:bundle": "bun scripts/probe-web-bundle.ts",
    "check:tokens": "bun scripts/gen-tokens.ts --check",
    "test:e2e": "bun run web:build && bun run test:e2e:run",
    "test:e2e:run": "E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run --config tests/e2e/e2e.config.ts",
    "test:e2e:update-screens": "bun run web:build && ARGUS_E2E_UPDATE_SCREENS=1 E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run --config tests/e2e/e2e.config.ts --update-snapshots visual.e2e.ts",
    "verify": "bun run check:comments && bun run check:boundaries && bun run check:tokens && tsc --noEmit && bun run lint && bun run test && bun run check:bundle && bun run test:e2e:run",
    "clean": "rm -rf .expo node_modules",
    "web:build": "expo export --platform web",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "postinstall": "bun scripts/link-argus-modules.mjs && bun scripts/patch-argus-modules.mjs && bun scripts/patch-expo-camera.mjs && bun scripts/patch-livekit-audio.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@legendapp/list": "^3.3.7",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@lodev09/react-native-true-sheet": "3.11.18",
    "@nozbe/watermelondb": "~0.28.0",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tauri-apps/api": "^2.11.1",
    "argus-camera": "file:./modules/argus-camera",
    "argus-face": "file:./modules/argus-face",
    "argus-mic": "file:./modules/argus-mic",
    "argus-net": "file:./modules/argus-net",
    "argus-push": "file:./modules/argus-push",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.0",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.15",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.21",
    "livekit-client": "2.22.3",
    "lucide": "^1.31.0",
    "lucide-react-native": "^1.25.0",
    "morphicons": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "rxjs": "^7.8.2",
    "sonner": "2.0.8",
    "sonner-native": "0.27.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "@e2e-dev/web": "0.14.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.17",
    "e2e": "0.19.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-sonarjs": "4.2.1",
    "expo-mcp": "~0.2.1",
    "nitrogen": "^0.36.5",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@radix-ui/react-focus-guards": "1.1.6",
    "@radix-ui/react-focus-scope": "1.1.16",
    "@radix-ui/react-portal": "1.1.17",
    "@radix-ui/react-presence": "1.1.10"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
