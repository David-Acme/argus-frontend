{
  "name": "argus-frontend",
  "author": "David Acme",
  "license": "SEE LICENSE IN LICENSE",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-camera"]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["@nozbe/watermelondb", "@nozbe/simdjson", "argus-face", "argus-net", "argus-mic", "argus-camera"],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "lint": "expo lint",
    "test": "tsc -p tests && bun test tests/unit",
    "check:comments": "bun scripts/check-comments.ts",
    "verify": "bun run check:comments && tsc --noEmit && bun run lint && bun run test",
    "clean": "rm -rf .expo node_modules",
    "web:build": "expo export --platform web",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "postinstall": "bun scripts/link-argus-modules.mjs && bun scripts/patch-argus-modules.mjs && bun scripts/patch-expo-camera.mjs && bunx install-skia && bunx setup-skia-web"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@legendapp/list": "^3.3.7",
    "@nozbe/watermelondb": "~0.28.0",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tauri-apps/api": "^2.11.1",
    "argus-face": "file:./modules/argus-face",
    "argus-mic": "file:./modules/argus-mic",
    "argus-net": "file:./modules/argus-net",
    "argus-camera": "file:./modules/argus-camera",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-system-ui": "~57.0.2",
    "lucide": "^1.31.0",
    "lucide-react-native": "^1.25.0",
    "morphicons": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "expo-mcp": "~0.2.1",
    "nitrogen": "^0.36.5",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
